<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\ContabilidadAPI.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Azure Document Intelligence Configuration -->
          <!-- Ahora las configuraciones se leen desde appsettings.Production.json -->
          <!-- Las variables de entorno se inyectan automáticamente durante el deployment con GitHub Actions -->
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>